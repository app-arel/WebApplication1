@model WebApplication1.Models.Country
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeaveManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <h1 class=" text-center text-warning mt-5 fw-light ">Create Categories</h1>
    <form method="post" asp-action="AddCountry">
        <div class="row justify-content-center">
            <input type="text" class=" form-control border-warning  w-75 mt-4" asp-for="Name" placeholder="Country Name" />
        </div>
        <div class="row justify-content-center">
            <button class="btn btn-outline-warning w-25 mt-5">Submit</button>
        </div>

    </form>
</body>
</html>